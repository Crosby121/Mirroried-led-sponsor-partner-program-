PORT=3000
NODE_ENV=production
APP_ORIGIN=https://sponsors.mirroriedled.com
TRUST_PROXY=true

# PostgreSQL
DATABASE_URL=postgresql://mirroried_portal:CHANGE_DATABASE_PASSWORD@db:5432/mirroried_portal
DATABASE_SSL=disable
DB_POOL_MAX=10

# First production administrator
ADMIN_EMAIL=admin@mirroriedled.com
ADMIN_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD_14_PLUS
ADMIN_NAME=Mirroried LED Administrator

# Session / file persistence
SESSION_HOURS=8
UPLOAD_DIR=/app/uploads

# Docker Compose database bootstrap
POSTGRES_DB=mirroried_portal
POSTGRES_USER=mirroried_portal
POSTGRES_PASSWORD=CHANGE_DATABASE_PASSWORD
